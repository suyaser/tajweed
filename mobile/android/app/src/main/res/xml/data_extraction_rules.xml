<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same rules as backup_rules.xml for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="audio/" />
    </device-transfer>
</data-extraction-rules>
